# Server Configuration
PORT=3100

# ChromaDB Configuration
CHROMA_URL=http://localhost:8100

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Configuration
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
USE_JINA_EMBEDDINGS=false
JINA_EMBEDDING_API_KEY=

# YouTube Configuration
YOUTUBE_COLLECTION_NAME=youtube_transcripts

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# LLM provider (entity extraction, context extraction, synthesis)
# Gemini, xAI Grok, and OpenAI supported (all via OpenAI-compatible APIs).
# Provider auto-detected: GEMINI_API_KEY -> gemini, XAI_API_KEY -> xai,
# else openai. Force with LLM_PROVIDER=gemini|xai|openai.
# Without any key: /ask and /patterns still work (raw retrieval, no synthesis).
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# Model overrides (defaults: gemini=gemini-2.5-flash, xai=grok-4-fast,
# openai=gpt-4o-mini/gpt-4o)
# LLM_EXTRACTION_MODEL=gemini-2.5-flash
# LLM_SYNTHESIS_MODEL=gemini-2.5-pro

# Security
# If API_KEY is set, all /api/* routes require the `x-api-key` header.
# Leave empty for local development.
API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Pattern layer cache TTL (seconds, default 6h)
PATTERN_CACHE_TTL_SECONDS=21600

# Eval Framework
EVAL_OUTPUT_DIR=./eval/results
EVAL_GOLDEN_PATH=./eval/golden.jsonl
