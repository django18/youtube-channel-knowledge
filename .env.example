# Server Configuration
PORT=3000

# ChromaDB Configuration
CHROMA_URL=http://localhost:8000
COLLECTION_NAME=scraped_content

# Scraper Configuration
MAX_DEPTH=3
MAX_CONCURRENT=5
REQUEST_DELAY=1000
USER_AGENT=Mozilla/5.0 (compatible; CustomScraper/1.0)

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Jina AI Configuration (Optional)
# Get your API keys from https://jina.ai/
JINA_API_KEY=
USE_JINA_EMBEDDINGS=false
JINA_EMBEDDING_API_KEY=

# Embedding Model (if using local embeddings)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
