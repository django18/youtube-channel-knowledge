{
  "name": "web-scraper-vector-db",
  "version": "1.0.0",
  "description": "TypeScript web scraper with Jina.ai and ChromaDB vector storage",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "example": "bun run scripts/example-scrape.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.0.0-rc.12",
    "chromadb": "^1.8.1",
    "hono": "^4.0.0",
    "ioredis": "^5.10.0",
    "neo4j-driver": "^6.0.1",
    "openai": "^6.32.0",
    "robots-parser": "^3.0.1",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
