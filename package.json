{
  "name": "youtube-knowledge-engine",
  "version": "2.0.0",
  "description": "YouTube transcript knowledge engine with dual-memory (Chroma + Neo4j) and eval framework",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "eval": "bun run scripts/run-eval.ts",
    "eval:bootstrap": "bun run scripts/bootstrap-golden.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chromadb": "^1.8.1",
    "hono": "^4.0.0",
    "ioredis": "^5.10.0",
    "neo4j-driver": "^6.0.1",
    "openai": "^6.32.0",
    "uuid": "^14.0.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0"
  }
}
